# Backend is initialized by the GitHub workflow using bootstrap outputs.
# State key: landing-zone/prod.terraform.tfstate
# Required backend options: use_oidc=true, use_azuread_auth=true
resource_group_name  = "REPLACE_WITH_BOOTSTRAP_RESOURCE_GROUP"
storage_account_name = "REPLACE_WITH_BOOTSTRAP_STORAGE_ACCOUNT"
container_name       = "tfstate"
key                  = "landing-zone/dev.terraform.tfstate"
use_oidc             = true
use_azuread_auth     = true
